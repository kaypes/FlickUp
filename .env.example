# Copy this file to .env and fill in the values.
# All variables are optional — defaults are used when not set.

# Path to your Google OAuth credentials file (default: ./credentials.json)
# FLICKUP_CREDENTIALS=/path/to/credentials.json

# Path where the OAuth token will be stored (default: ~/.config/flickup/token.json)
# FLICKUP_TOKEN=/path/to/token.json
